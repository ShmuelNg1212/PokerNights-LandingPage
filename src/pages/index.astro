---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import AppFrame from '../components/AppFrame.astro';
import Steps from '../components/Steps.astro';
import Compare from '../components/Compare.astro';
import Features from '../components/Features.astro';
import Faq from '../components/Faq.astro';
import Closing from '../components/Closing.astro';
---
<Layout
  title="PokerNights: buy-ins and settle-up for home poker nights"
  description="PokerNights keeps the bank for your home poker game: buy-ins, rebuys, cash-outs and who pays whom at the end. It never moves money."
  diagrams
  moments
>
  <Nav />
  <main id="top">
    <Hero />
    <AppFrame />
    <Steps />
    <Compare />
    <Features />
    <Faq />
  </main>
  <Closing />
</Layout>

<script>
  import { initLive } from '../scripts/live';
  import { initOpen } from '../scripts/open';
  import { initMedia } from '../scripts/media';
  import { initRoll } from '../scripts/roll';
  import { initRise } from '../scripts/rise';
  import { initSweep } from '../scripts/sweep';
  initRoll();
  initLive();
  initOpen();
  initMedia();
  initRise();
  initSweep();
</script>

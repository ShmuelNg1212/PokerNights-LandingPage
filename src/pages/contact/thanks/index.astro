---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Closing from '../../../components/Closing.astro';
---
<Layout title="Request sent · PokerNights" description="Your request to host a PokerNights group was sent.">
  <Nav base="/" />
  <main id="top">
    <section class="hero" aria-labelledby="hero-h">
      <div class="wrap">
        <div class="hero-text stack-5">
          <h1 id="hero-h">Request sent</h1>
          <p class="hero__lead">You will hear back on the contact you gave. Until then, read how a first night works.</p>
          <div class="btn-row"><a class="btn btn--secondary" href="/#steps">See the first night</a></div>
        </div>
      </div>
    </section>
  </main>
  <Closing base="/" />
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Closing from '../../components/Closing.astro';
import Arrow from '../../components/Arrow.astro';
import { Image } from 'astro:assets';
import { LOGIN } from '../../lib/links';
import openSet from '../../assets/app/open-set.png';
---
<Layout
  title="Request a group · PokerNights"
  description="Want to keep the bank for your own home poker game? Ask for a PokerNights host account."
>
  <Nav base="/" />
  <main id="top">
    <section class="hero contact-hero" aria-labelledby="hero-h">
      <div class="wrap">
        <div class="hero-text grid grid--top">
          <div class="span-5 stack-5">
            <h1 id="hero-h">Request a group</h1>
            <p class="hero__lead">New groups are set up by hand for now. Say who you are and how many people play. You become the host, then you invite your table with a link.</p>
            <p class="t-small muted">Already invited? Open the link from the chat, or <a class="link" href={LOGIN}>log in</a>.</p>
            <div class="contact-shot">
              <Image src={openSet} alt="What a host sees before a set: Ready to start, the seat draw, and Start the set." widths={[280, 560]} sizes="280px" loading="eager" />
            </div>
          </div>
          <form class="form span-6 start-7" name="host-request" method="POST" action="/contact/thanks/" data-netlify="true" netlify-honeypot="company">
            <input type="hidden" name="form-name" value="host-request" />
            <p class="trap" aria-hidden="true"><label>Leave this empty <input name="company" tabindex="-1" autocomplete="off" /></label></p>
            <label class="field field--full">Your name<input name="name" type="text" autocomplete="name" required maxlength="80" /></label>
            <label class="field field--full">How to reach you<input name="contact" type="text" required maxlength="160" placeholder="Email, or your Messenger or Viber name" /></label>
            <label class="field">Group name<input name="group" type="text" maxlength="80" placeholder="Friday table" /></label>
            <label class="field">How many people play
              <select name="players"><option value="2-5">2 to 5</option><option value="6-9" selected>6 to 9</option><option value="10+">10 or more</option></select>
            </label>
            <label class="field field--full">Anything else (optional)<textarea name="message" rows="4" maxlength="1200" placeholder="Pesos or chips, how often you play"></textarea></label>
            <div class="btn-row"><button class="btn btn--primary" type="submit">Request a group<Arrow /></button></div>
            <p class="t-small muted">Your message goes only to the person who runs PokerNights. The reply comes on the contact you give.</p>
          </form>
        </div>
      </div>
    </section>
  </main>
  <Closing base="/" />
</Layout>

<style>
  .contact-shot { width: 280px; height: 300px; overflow: hidden; border-radius: var(--rk-r-sheet) var(--rk-r-sheet) 0 0; background: var(--rk-ground); }
  .contact-shot :global(img) { width: 100%; height: auto; }
  .trap { position: absolute; left: -9999px; }
  @media (max-width: 1023px) { .contact-shot { display: none; } }
</style>

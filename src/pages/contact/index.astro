---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { APP, LOGIN } from '../../lib/links';
import openSet from '../../assets/app/open-set.png';
---
<Layout
  title="Host a group · PokerNights"
  description="Want to keep the bank for your own home poker game? Ask for a PokerNights host account."
>
  <main id="main" class="contact">
    <div class="contact-words">
      <a class="contact-mark" href="/"><img src="/brand/logo-horizontal.svg" alt="PokerNights home" width="170" height="32" /></a>
      <figure class="contact-shot">
        <Image src={openSet} alt="What a host sees before a set: Ready to start, the seat draw, and Start the set." widths={[340, 680]} sizes="340px" loading="eager" />
      </figure>
      <div>
        <h1 class="h-l">Host a group</h1>
        <p class="lead">New groups are set up by hand for now. Say who you are and how many people play, and you will get a host account. Then you invite your table with a link.</p>
        <p class="aside">Already invited? <a class="text-link" href={APP}>Open PokerNights</a> or <a class="text-link" href={LOGIN}>log in</a>.</p>
      </div>
    </div>

    <form class="contact-form" name="host-request" method="POST" action="/contact/thanks/" data-netlify="true" netlify-honeypot="company">
      <input type="hidden" name="form-name" value="host-request" />
      <p class="trap" aria-hidden="true"><label>Leave this empty <input name="company" tabindex="-1" autocomplete="off" /></label></p>

      <div class="field">
        <label for="c-name">Your name</label>
        <input id="c-name" name="name" type="text" autocomplete="name" required maxlength="80" />
      </div>
      <div class="field">
        <label for="c-reach">How to reach you</label>
        <input id="c-reach" name="contact" type="text" required maxlength="160" aria-describedby="c-reach-help" />
        <p class="help" id="c-reach-help">An email address, or your Messenger or Viber name.</p>
      </div>
      <div class="field">
        <label for="c-group">Group name</label>
        <input id="c-group" name="group" type="text" maxlength="80" placeholder="Friday table" />
      </div>
      <fieldset class="field sizes">
        <legend>How many people play</legend>
        <div class="size-options">
          <label><input type="radio" name="players" value="2-5" /><span>2 to 5</span></label>
          <label><input type="radio" name="players" value="6-9" checked /><span>6 to 9</span></label>
          <label><input type="radio" name="players" value="10+" /><span>10 or more</span></label>
        </div>
      </fieldset>
      <div class="field">
        <label for="c-note">Anything else <span class="optional">(optional)</span></label>
        <textarea id="c-note" name="message" rows="4" maxlength="1200" placeholder="Pesos or chips, how often you play"></textarea>
      </div>
      <button class="pill" type="submit">Send</button>
      <p class="help">Your message goes only to the person who runs PokerNights.</p>
    </form>
  </main>
</Layout>

<style>
  .contact { display: grid; grid-template-columns: 1fr 1fr; min-height: 100svh; }
  .contact-words { display: flex; flex-direction: column; justify-content: space-between; gap: 64px; padding: 36px 40px 56px; background: var(--ground); }
  .contact-mark img { height: 32px; width: auto; }
  .contact-shot { width: min(340px, 70%); height: 46svh; min-height: 320px; overflow: hidden; border-radius: 26px; margin: 0; background: var(--rail); }
  .contact-shot :global(img) { width: 100%; height: auto; }
  .contact-words h1 { margin-bottom: 24px; }
  .lead { max-width: 42ch; font-size: var(--t-body); }
  .aside { margin-top: 28px; color: var(--muted); font-size: var(--t-s); }
  .aside a { color: var(--text); font-weight: 650; }
  .contact-form { display: grid; align-content: center; gap: 22px; padding: 56px max(40px, 8vw); background: var(--rail); }
  .field { display: grid; gap: 8px; margin: 0; padding: 0; border: 0; min-width: 0; }
  .field > label, legend { font-size: var(--t-body); font-weight: 650; padding: 0; }
  .optional { color: var(--muted); font-weight: 500; }
  input[type="text"], textarea {
    width: 100%; min-height: 52px; padding: 12px 14px; border-radius: var(--r-field);
    border: 1px solid var(--line); background: var(--ground); color: var(--text); font-size: 1rem; line-height: 1.4;
  }
  textarea { resize: vertical; min-height: 110px; }
  input::placeholder, textarea::placeholder { color: color-mix(in oklch, var(--muted) 70%, transparent); }
  input:focus-visible, textarea:focus-visible { outline: 3px solid var(--focus); outline-offset: 1px; }
  .help { color: var(--muted); font-size: var(--t-s); }
  .size-options { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; padding: 5px; border-radius: 16px; background: var(--ground); }
  .size-options label { position: relative; }
  .size-options input { position: absolute; opacity: 0; pointer-events: none; }
  .size-options span { display: flex; align-items: center; justify-content: center; min-height: 46px; border-radius: 12px; color: var(--muted); font-weight: 650; cursor: pointer; transition: background-color var(--t-fast) var(--ease-out), color var(--t-fast) var(--ease-out); }
  .size-options input:checked + span { background: var(--surface-2); color: var(--text); }
  .size-options input:focus-visible + span { outline: 3px solid var(--focus); outline-offset: 1px; }
  .contact-form .pill { justify-self: start; min-width: 160px; }
  .trap { position: absolute; left: -9999px; }

  @media (max-width: 860px) {
    .contact { grid-template-columns: 1fr; }
    .contact-words { padding: 24px 20px 40px; gap: 48px; }
    .contact-mark img { height: 28px; }
    .contact-shot { width: 100%; height: 300px; min-height: 0; }
    .contact-form { padding: 40px 20px 64px; }
    .contact-form .pill { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) { .size-options span { transition: none; } }
</style>

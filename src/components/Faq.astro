---
import Video from './Video.astro';
import { CONTACT } from '../lib/links';

const items: Array<{ q: string; a: string; html?: boolean }> = [
  { q: 'Does PokerNights move money?', a: 'No. It records who owes whom. You pay each other the way you always do, and the host marks each transfer paid.' },
  { q: 'How do I get in?', a: 'Ask your host for an invite link. It works for 7 days. Open it and make your account from it. If you already play, just log in.' },
  { q: 'I want to host. How do I start a group?', a: `New groups are set up by hand for now. <a class="text-link" href="${CONTACT}">Send a message</a> with how many people play, and the person who runs PokerNights sets up your group with you as its host.`, html: true },
  { q: 'Does it work in chips as well as pesos?', a: 'Yes. Each game counts in pesos or in chips, chosen by the host. The app never converts one into the other.' },
  { q: 'Can a friend without the app play?', a: 'Yes. The host adds them to the table by name, with no login, and records their buy-ins for them.' },
  { q: 'What if someone types a wrong amount?', a: 'The host reverses it with a reason, and the reversed entry stays in the log. If the count is still off, the host notes who takes the difference.' },
  { q: 'Is it an app from the store?', a: 'No, it is a web app. Put it on your home screen from Safari or Chrome. A link opened inside Messenger or Viber must open in the real browser first; the app shows you how.' },
  { q: 'Who sees my results?', a: 'Only the people in your group. Anyone outside it gets “not found” for everything in it.' },
];
---
<section class="faq wrap" aria-labelledby="faq-title">
  <div class="faq-side">
    <h2 class="faq-title h-l" id="faq-title" data-reveal>Before you play</h2>
    <figure class="faq-clip" data-reveal>
      <Video name="recap" label="The PokerNights session recap on a phone: every player's result, then who pays whom." />
      <figcaption>The session recap: every player’s result, then who pays whom.</figcaption>
    </figure>
  </div>
  <div class="faq-list">
    {items.map((item, i) => (
      <details name="faq" class="tile" open={i === 0} data-reveal>
        <summary><span>{item.q}</span><i class="sign" aria-hidden="true" /></summary>
        {item.html ? <p set:html={item.a} /> : <p>{item.a}</p>}
      </details>
    ))}
  </div>
</section>

<style>
  .faq { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px; padding-top: var(--section-gap); align-items: start; }
  .faq-side { grid-column: 1 / span 4; position: sticky; top: 96px; }
  .faq-title { margin-bottom: 40px; }
  .faq-clip { width: min(240px, 80%); margin: 0; }
  .faq-clip figcaption { margin-top: 12px; color: var(--muted); font-size: var(--t-s); max-width: 26ch; }
  .faq-list { grid-column: 5 / -1; display: grid; gap: 8px; }
  .tile { border-radius: 18px; background: var(--rail); transition: background-color 200ms var(--ease-out), color 200ms var(--ease-out); }
  .tile[open] { background: var(--brass); color: var(--ink); }
  summary { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 72px; padding: 18px 24px; list-style: none; cursor: pointer; font-size: var(--t-m); font-weight: 600; letter-spacing: -0.005em; }
  summary::-webkit-details-marker { display: none; }
  summary:focus-visible { outline-offset: -3px; border-radius: 18px; }
  .sign { position: relative; flex: none; width: 16px; height: 16px; }
  .sign::before, .sign::after { content: ''; position: absolute; left: 0; top: 6.5px; width: 16px; height: 3px; border-radius: 2px; background: currentColor; transition: transform 200ms var(--ease-out); }
  .sign::after { transform: rotate(90deg); }
  .tile[open] .sign::after { transform: rotate(0deg); }
  @supports selector(::details-content) {
    @media (prefers-reduced-motion: no-preference) {
      .tile { interpolate-size: allow-keywords; }
      .tile::details-content { height: 0; overflow: clip; transition: height 220ms var(--ease-out), content-visibility 220ms allow-discrete; }
      .tile[open]::details-content { height: auto; }
    }
  }
  .tile p { max-width: 52ch; padding: 0 24px 24px; font-size: var(--t-body); }
  .tile[open] p :global(a) { color: var(--ink); }

  @media (max-width: 900px) {
    .faq { display: block; }
    .faq-side { position: static; margin-bottom: 28px; display: grid; grid-template-columns: 1fr auto; gap: 20px; align-items: end; }
    .faq-title { margin: 0; }
    .faq-clip { width: 120px; }
    .faq-clip figcaption { display: none; }
    .faq-list { gap: 6px; }
    summary { min-height: 64px; padding: 16px 20px; }
    .tile p { padding: 0 20px 20px; }
  }
  @media (prefers-reduced-motion: reduce) { .tile, .sign::before, .sign::after { transition: none; } }
</style>

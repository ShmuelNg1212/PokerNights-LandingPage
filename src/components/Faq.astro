---
import Video from './Video.astro';
import { CONTACT } from '../lib/links';
const items: Array<{ q: string; a: string; wide?: boolean }> = [
  { q: 'Does PokerNights move money?', a: 'No. It records who owes whom. You pay each other the way you always do, and the host marks each transfer paid.' },
  { q: 'How do I get into the app?', a: 'Ask your host for an invite link. It works for 7 days. Open it and make your account from it. If you already play, log in.' },
  { q: 'How do I start a group in the app?', a: 'New groups are set up by hand for now. Send a request with how many people play, and you become its host.' },
  { q: 'Does the app count chips as well as pesos?', a: 'Yes. Each game counts in pesos or in chips, chosen by the host. The app never converts one into the other.' },
  { q: 'Can a friend without the app play?', a: 'Yes. The host adds them to the table by name, with no login, and records their buy-ins for them.', wide: true },
  { q: 'Who sees my results in the app?', a: 'Only the people in your group. Anyone outside it gets “not found” for everything in it.' },
];
---
<section class="section" id="questions" style="--hm: 2" aria-labelledby="questions-h">
  <div class="wrap">
    <div class="grid grid--top">
      <div class="span-6 faq-side">
        <div class="stack-4">
          <h2 id="questions-h" data-rise>Questions</h2>
          <p><a class="link" href={CONTACT}>Request a group</a></p>
        </div>
        <div class="faq-clip"><Video name="recap" label="The PokerNights session recap on a phone: every player's result, then who pays whom." /></div>
      </div>
      <div class="faq span-6 start-7">
        {items.map((item) => (
          <div class:list={['faq__item', item.wide && 'faq__item--wide']}>
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

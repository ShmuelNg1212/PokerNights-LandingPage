---
import { APP, LOGIN, CONTACT } from '../lib/links';
---
<footer class="foot">
  <p class="foot-what">The bank for home poker nights</p>
  <nav class="foot-links" aria-label="Footer">
    <a class="text-link" href={APP}>Open the app</a>
    <a class="text-link" href={LOGIN}>Log in</a>
    <a class="text-link" href="/#first-night">How to start</a>
    <a class="text-link" href={CONTACT}>Host a group</a>
  </nav>
  <p class="foot-year">© 2026 PokerNights · It never moves money.</p>
</footer>

<style>
  .foot {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: baseline;
    gap: 24px;
    padding: 30svh var(--gutter) 30px;
    font-size: var(--t-s);
    color: var(--muted);
  }
  .foot-links { display: flex; flex-wrap: wrap; gap: 8px 24px; justify-content: center; }
  .foot-links a { color: var(--text); font-weight: 600; }
  .foot-year { text-align: right; }
  @media (max-width: 860px) {
    .foot { grid-template-columns: 1fr; gap: 8px; padding: 20svh 20px 24px; }
    .foot-links { justify-content: flex-start; }
    .foot-year { text-align: left; }
  }
</style>

---
import PlayerRow from './PlayerRow.astro';
import { createTable } from '../../lib/table';
import { peso } from '../../lib/money';

const table = createTable().snapshot();
const player = table.players.find(({ id }) => id === 'carlo')!;
---
<div class="ui ui-pn live-set" data-app data-live-set role="group" aria-labelledby="hero-table">
  <div class="live-set__head">
    <h3 id="hero-table">Friday table</h3>
    <div>
      <span class="pot-label">Still in play</span>
      <strong class="display-amount" data-pot aria-live="polite">{peso(table.pot)}</strong>
    </div>
  </div>
  <ul class="player-list">
    <PlayerRow id={player.id} name={player.name} initials={player.initials} colour={player.colour}
               buyIns={player.buyIns.length} boughtIn={player.boughtIn} live />
  </ul>
</div>

<style>
  .live-set {
    width: min(100%, 380px);
    border: 1px solid var(--rk-rule);
    border-radius: 20px;
    background: var(--rk-ground);
  }
  .live-set__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 12px;
    padding: 12px 14px;
    border-bottom: 1px solid var(--rk-rule);
  }
  .live-set__head h3 {
    font-size: 1rem;
    font-weight: 700;
  }
  .live-set__head > div {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-left: auto;
  }
  .live-set .pot-label { color: var(--rk-bone-dim); white-space: nowrap; }
  .live-set .display-amount { font-size: clamp(1.2rem, 3.8vw, 1.5rem); }
  .live-set .player-list { padding-inline: 14px; }
  .live-set :global(.player-row) {
    position: relative;
    grid-template-columns: 34px minmax(0, 1fr) auto auto;
    gap: 8px;
  }
  .live-set :global(.player-row:not(.is-marked)) { border-bottom-color: transparent; }
  .live-set :global(.player-row.is-marked) {
    box-shadow: none;
    padding-inline: 0;
    margin-inline: 0;
  }
  .live-set :global(.player-row .chip) { width: 34px; height: 34px; }
  .live-set :global(.player-row .pn-btn) { grid-column: auto; min-height: 44px; padding-inline: 10px; }
  .live-set :global(.player-row .player-meta) { display: none; }
  .live-set :global(.player-row.is-marked .player-identity) { transform: translateY(-7px); }
  .live-set :global(.player-row .row-mark) {
    position: absolute;
    left: 42px;
    top: calc(50% + 4px);
    margin: 0;
    padding: 0;
    box-shadow: none;
    font-size: .625rem;
    white-space: nowrap;
  }
  @media (max-width: 359px) {
    .live-set .player-list { padding-inline: 10px; }
    .live-set :global(.player-row) { gap: 6px; }
    .live-set :global(.player-row .row-mark) { left: 40px; }
    .live-set :global(.player-row .pn-btn svg) { display: none; }
  }
</style>

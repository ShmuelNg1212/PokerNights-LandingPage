---
import { createTable } from '../../lib/table';
import { peso } from '../../lib/money';
import { chipClass, transferCount } from '../../lib/labels';

const t = createTable().snapshot();
const people = new Map(t.players.map((p) => [p.id, p]));
const rows = t.transfers.map((x) => ({ from: people.get(x.from)!, to: people.get(x.to)!, amount: peso(x.amount) }));
---
<div class="ui-card transfers" data-ui>
  <div class="transfers-head">
    <h3>Who pays whom</h3>
    <span class="ui-badge is-brass">Unsettled</span>
  </div>
  <p class="ui-muted">Friday table · <span data-transfer-count>{transferCount(rows.length)}</span></p>
  <ul class="ui-rows" data-transfers aria-live="polite">
    {rows.map((r) => (
      <li>
        <span class={`chip is-small ${chipClass(r.from.colour)}`} aria-hidden="true" data-from-chip>{r.from.initials}</span>
        <span data-from>{r.from.name}</span>
        <span class="arrow" aria-hidden="true">→</span><span class="visually-hidden">pays</span>
        <span class={`chip is-small ${chipClass(r.to.colour)}`} aria-hidden="true" data-to-chip>{r.to.initials}</span>
        <span data-to>{r.to.name}</span>
        <span class="amt" data-amount>{r.amount}</span>
      </li>
    ))}
  </ul>
  <p class="transfers-foot">The app records payments. It does not move money.</p>
</div>

<style>
  .transfers { padding: 18px 16px 14px; }
  .transfers-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 4px; }
  .transfers .ui-rows li { gap: 6px; font-size: .875rem; }
  .transfers-foot { margin: 10px 0 0; padding-top: 10px; border-top: 1px solid var(--rule); color: var(--bone-dim); font-size: .8125rem; } /* taste-skill-ignore: data-ui fragment */
</style>

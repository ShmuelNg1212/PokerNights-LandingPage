---
import Icon from '../Icon.astro';
import { peso } from '../../lib/money';
import { buyInLabel, chipClass, MAX_STACK } from '../../lib/labels';

interface Props {
  id: string;
  name: string;
  initials: string;
  colour: number;
  buyIns: number;
  boughtIn: number;
  /** Renders a working Rebuy button bound to the shared table. */
  live?: boolean;
}
const { id, name, initials, colour, buyIns, boughtIn, live = false } = Astro.props;
const stack = Math.min(buyIns, MAX_STACK);
---
<li class="player-row" data-player={live ? id : undefined}>
  <span class={`chip ${chipClass(colour)}`} aria-hidden="true" data-initials={initials}></span>
  <span class="player-identity">
    <span class="player-name">{name}</span>
    <span class="player-meta">
      <span class="buy-stack" data-stack aria-hidden="true">{Array.from({ length: stack }, () => <i />)}</span>
      <span data-label>{buyInLabel(buyIns)}</span>
    </span>
  </span>
  <span class="player-figure">
    <span data-bought>{peso(boughtIn)}</span>
    <small>bought in</small>
    {live && <span class="row-mark" data-mark hidden>Rebuy added</span>}
  </span>
  {live ? (
    <button type="button" class="pn-btn" data-rebuy={id} aria-label={`Rebuy for ${name}`}>
      <Icon name="plus" />Rebuy
    </button>
  ) : (
    <span class="pn-btn" aria-hidden="true"><Icon name="plus" />Rebuy</span>
  )}
</li>

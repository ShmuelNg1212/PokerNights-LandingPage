---
import { Image } from 'astro:assets';
import Video from './Video.astro';
import Transfers from './ui/Transfers.astro';
import rebuySheet from '../assets/app/rebuy-sheet.png';
---
<section class="first-night" id="first-night" aria-labelledby="first-night-title">
  <ol class="fields">
    <li class="field f1">
      <h2 class="h-l field-title" id="first-night-title" data-reveal>Your first night</h2>
      <div class="field-card" data-reveal>
        <div class="ui-card invite" data-ui>
          <img src="/brand/logo-mark.svg" alt="" width="40" height="40" />
          <h3>Join Friday table</h3>
          <p class="ui-muted">Hana invited you · 6 players</p>
          <span class="ui-field" aria-hidden="true">Username</span>
          <span class="ui-field" aria-hidden="true">Password</span>
          <span class="ui-btn is-primary is-block" aria-hidden="true">Create account and join</span>
        </div>
      </div>
      <div class="field-words" data-reveal>
        <h3 class="h-m">First, your host sends&nbsp;a&nbsp;link.</h3>
        <p>Open it in Safari or Chrome and make your account there. A link works for 7 days.</p>
      </div>
    </li>
    <li class="field f2">
      <div class="field-card" data-reveal>
        <Video name="seat-draw" class="card-clip" label="The PokerNights seat draw on a phone: the dealer seat is drawn among six players." />
      </div>
      <div class="field-words" data-reveal>
        <h3 class="h-m">Then put it on your&nbsp;phone.</h3>
        <p>iPhone: Share, then Add to Home Screen. Android: the menu, then Install app. A seat draw plays on every phone.</p>
      </div>
    </li>
    <li class="field f3">
      <div class="field-card" data-reveal>
        <div class="card-still">
          <Image src={rebuySheet} alt="PokerNights on a phone: the Rebuy sheet for Carlo, ₱1,000 typed on the app's number keys, over a set with ₱6,000 still in play." widths={[260, 520, 780]} sizes="260px" />
        </div>
      </div>
      <div class="field-words" data-reveal>
        <h3 class="h-m">The host keeps the&nbsp;bank.</h3>
        <p>Each buy-in and rebuy is one tap. Every phone at the table sees the change within about five seconds.</p>
      </div>
    </li>
    <li class="field f4">
      <div class="field-card" data-reveal>
        <Transfers />
      </div>
      <div class="field-words" data-reveal>
        <h3 class="h-m">Last, who pays&nbsp;whom.</h3>
        <p>The host counts up and the books are checked. Then you pay each other, the fewest times.</p>
      </div>
    </li>
  </ol>
</section>

<style>
  .first-night { margin-top: var(--section-gap); }
  .fields { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 0; padding: 0; list-style: none; }
  .field {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: max(84svh, 720px);
    padding: 28px 28px 32px;
    transition: none;
  }
  .f1 { background: var(--rail-2); }
  .f2 { background: var(--ground); }
  .f3 { background: var(--felt); --muted: var(--felt-ink); }
  .f4 { background: var(--bone); color: var(--ink); --muted: oklch(0.38 0.02 60); }
  .field-title { grid-row: 1; }
  .field-card {
    grid-row: 2;
    align-self: center;
    justify-self: center;
    width: 260px;
    margin-block: 40px;
    transition: transform 150ms var(--ease-out);
  }
  @media (hover: hover) { .field:hover .field-card { transform: translateY(-6px); } }
  .field-words { grid-row: 3; }
  .field-words h3 { font-size: var(--t-m); font-weight: 700; margin-bottom: 12px; text-wrap: balance; }
  .field-words p { color: var(--text); font-size: var(--t-body); max-width: 34ch; }
  .f4 .field-words p { color: var(--ink); }

  .invite { display: grid; gap: 8px; padding: 20px 18px; }
  .invite img { margin-bottom: 6px; }
  .invite .ui-muted { margin-bottom: 8px; }
  .ui-field { display: flex; align-items: center; min-height: 46px; padding: 0 12px; border-radius: var(--r-field); border: 1px solid var(--line); background: var(--ground); color: var(--bone-dim); font-size: .9375rem; }
  .invite .ui-btn { margin-top: 6px; }

  .card-still { overflow: hidden; height: 360px; border-radius: 26px; background: var(--ground); }
  .card-still :global(img) { width: 100%; height: auto; }
  .field-card :global(.card-clip) { aspect-ratio: 260 / 360; }
  .field-card :global(.card-clip :is(img, video)) { object-position: center 45%; }

  @media (max-width: 1100px) {
    .fields { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .field { min-height: 760px; }
  }
  @media (max-width: 640px) {
    .fields { grid-template-columns: 1fr; }
    .field { min-height: 64svh; grid-template-rows: auto auto auto; padding: 36px 20px 44px; }
    .field-title { margin-bottom: 28px; }
    .field-words { grid-row: 2; }
    .field-card { grid-row: 3; justify-self: start; margin: 32px 0 0; }
    .f1 .field-title { grid-row: 1; }
  }
  @media (prefers-reduced-motion: reduce) { .field-card { transition: none; } .field:hover .field-card { transform: none; } }
</style>

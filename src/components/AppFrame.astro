---
import { createTable, nightLog, standings } from '../lib/table';
import { peso, signedPeso } from '../lib/money';
import { chipClass, entryCount, transferCount, ENTRY_LABEL, resultTone } from '../lib/labels';

const t = createTable().snapshot();
const people = new Map(t.players.map((p) => [p.id, p]));
const log = nightLog(t);
---
<section class="section" id="table" data-replay aria-labelledby="table-h">
  <div class="wrap">
    <div class="grid section-head--row">
      <h2 id="table-h" data-rise class="span-6">PokerNights keeps the log and works out who pays whom</h2>
      <p class="span-6 start-7 muted">The host logs each buy-in and rebuy as it happens. At the end the stacks are counted, the books are checked, and the transfers appear. <a class="link" href="#steps">See the first night</a></p>
    </div>
    <div class="ui app fill" role="group" aria-label="The PokerNights session page for Friday table: the night's log beside who pays whom">
      <div class="app__pane app__pane--list"><div class="ui ui-pn pane-body" data-app>
        <div class="app-head">
          <span class="app-head__title">Friday table · Session log</span>
          <span class="pn-badge is-quiet" data-log-count>{entryCount(log.length)}</span>
        </div>
        <ol class="log" data-log>
          {log.map((e) => (
            <li class:list={['log-row', `is-${e.kind}`]}>
              <time class="log-time">{e.time}</time>
              <span class={`chip is-small ${chipClass(e.colour)}`} aria-hidden="true" data-log-chip data-initials={e.initials}></span>
              <span class="log-who"><strong data-log-name>{e.name}</strong><small data-log-kind>{ENTRY_LABEL[e.kind]}</small></span>
              <span class="log-amt" data-log-amt>{peso(e.amount)}</span>
            </li>
          ))}
        </ol>
      </div></div>
      <div class="app__pane app__pane--open"><div class="ui ui-pn pane-body" data-app>
        <div class="app-head">
          <span class="app-head__title">Who pays whom</span>
          <span class="pn-badge is-brass" data-transfer-count>{transferCount(t.transfers.length)}</span>
        </div>
        <p class="pay-wait pn-muted">Who pays whom appears when every stack is counted.</p>
        <ul class="pay-list" data-transfers data-pay-list>
          {t.transfers.map((x, i) => {
            const from = people.get(x.from)!;
            const to = people.get(x.to)!;
            return (
              <li class="pay-row" data-pay-row data-m-loop={i === 0 ? '' : undefined}>
                <span class={`chip ${chipClass(from.colour)}`} aria-hidden="true" data-from-chip data-initials={from.initials}></span>
                <span class="pay-who"><strong data-from>{from.name}</strong><small>pays <span data-to>{to.name}</span></small></span>
                <span class="pay-amt" data-amount>{peso(x.amount)}</span>
                <button type="button" class="pn-btn pay-btn" data-mark-paid={i} aria-pressed="false">
                  <span class="pay-btn__idle">Mark paid</span><span class="pay-btn__done">Paid</span>
                </button>
              </li>
            );
          })}
        </ul>
        <div class="app-head app-head--sub"><span class="app-head__title">Results</span><span class="pn-muted">after count-up</span></div>
        <ul class="standings" data-standings>
          {standings(t).map((r) => {
            const p = people.get(r.id)!;
            return (
              <li class="standing" data-standing data-st-id={r.id}>
                <span class={`chip is-small ${chipClass(p.colour)}`} aria-hidden="true" data-st-chip data-initials={p.initials}></span>
                <span class="standing__name" data-st-name>{p.name}</span>
                <span class="standing__in" data-st-in>{peso(r.boughtIn)} in</span>
                <span class:list={['standing__res', resultTone(r.result)]} data-st-res>{signedPeso(r.result)}</span>
              </li>
            );
          })}
        </ul>
        <p class="pay-foot">PokerNights records each payment. It does not move money.</p>
      </div></div>
    </div>
  </div>
</section>

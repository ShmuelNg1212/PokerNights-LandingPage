---
const columns = ['PokerNights', 'A notebook', 'A group-chat tally'];
const rows: Array<[string, string, string, string]> = [
  ['Buy-ins and rebuys', 'One tap, with the time', 'Written by hand', 'Typed by whoever remembers'],
  ['The books balance', 'Checked at count-up, the gap named', 'Add it all up yourself', 'Scroll up and add'],
  ['A wrong entry', 'Reversed with a reason, kept in the log', 'Crossed out', 'Edited, the old one gone'],
  ['Who pays whom', 'Worked out, fewest transfers', 'Sums at two in the morning', 'Argued in the thread'],
  ['Rake', 'Taken per buy-in, kept apart', 'Hard to keep track of', 'Hard to keep track of'],
  ['Last month’s games', 'Every closed session, per player', 'Somewhere in a drawer', 'Buried in the chat'],
];
---
<section class="section" id="compare" aria-labelledby="compare-h">
  <div class="wrap">
    <div class="section-head">
      <h2 id="compare-h">PokerNights next to a notebook</h2>
    </div>
    <div class="cmp" role="table" aria-label="PokerNights compared with a notebook and a group-chat tally">
      <div class="grid cmp__row cmp__head" role="row">
        <span class="span-3 cmp__opt" role="columnheader">Part of the game</span>
        <span class="span-3 cmp__opt is-ours" role="columnheader"><img loading="lazy" src="/brand/logo-mark.svg" alt="" width="24" height="24" />PokerNights</span>
        <span class="span-3 cmp__opt" role="columnheader">A notebook</span>
        <span class="span-3 cmp__opt" role="columnheader"><span class="cmp__marks"><img loading="lazy" data-icon="messenger" src="/assets/icons/messenger.svg" alt="Messenger" width="24" height="24" /><img loading="lazy" data-icon="si:viber" src="/assets/icons/viber.svg" alt="Viber" width="24" height="24" /></span>A group-chat tally</span>
      </div>
      {rows.map(([name, ...answers]) => (
        <div class:list={['grid', 'cmp__row', name === 'Rake' && 'cmp__row--wide', name === 'Last month’s games' && 'cmp__row--phone-cut']} role="row">
          <span class="span-3 cmp__name" role="rowheader">{name}</span>
          {answers.map((a, i) => (
            <span class:list={['span-3', 'cmp__cell', i === 0 && 'is-ours']} role="cell" data-col={columns[i]}>{a}</span>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

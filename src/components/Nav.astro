---
import Arrow from './Arrow.astro';
import { LOGIN, NAV } from '../lib/links';

interface Props {
  /** '' on the home page; '/' on inner pages, so the words lead back to the home page's sections. */
  base?: string;
}
const { base = '' } = Astro.props;
---
<header class="nav nav--centre">
  <div class="wrap nav__bar">
    <a class="skip-link" href="#top">Skip to content</a>
    <a class="nav__logo" href={`${base}#top`}><img src="/brand/logo-horizontal.svg" alt="PokerNights" width="148" height="28" /></a>
    <nav class="nav__links" aria-label="Main">
      {NAV.map((n) => (
        <div class="nav__item"><a class="nav__link" href={`${base}#${n.id}`}>{n.word}</a></div>
      ))}
    </nav>
    <div class="nav__actions">
      <a class="nav__link" href={LOGIN}>Log in</a>
      <a class="btn btn--primary" href={`${base}#join`}>Join your group<Arrow /></a>
    </div>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Menu">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
    </button>
  </div>
</header>
